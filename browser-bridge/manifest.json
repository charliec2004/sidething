{
  "manifest_version": 3,
  "name": "Car Thing Video Bridge",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
